// MeuPerfil — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan                 Plan                @default(FREE)
  subscriptionStatus   SubscriptionStatus  @default(NONE)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  usagePeriodStart     DateTime            @default(now())
  dmsSentThisPeriod    Int                 @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  billingEvents     BillingEvent[]
  operationalEvents OperationalEvent[]
  profiles          Profile[]
  scheduledPosts    ScheduledPost[]
  contacts          Contact[]
  leadInteractions  LeadInteraction[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations    Automation[]
  dmLogs         DmLog[]
  linkClicks     LinkClick[]
  scheduledPosts ScheduledPost[]

  @@index([workspaceId])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String
  postUrl        String?
  keywords       String[]
  dmMessage      String
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  /// Accept one wrong letter in keywords of 5+ characters.
  typoTolerance  Boolean @default(false)
  /// Optional end of the campaign; null means it never expires.
  endsAt         DateTime?
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  leadInteractions LeadInteraction[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  /// Post or reel the comment was made on (useful for "all posts" campaigns).
  mediaId        String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model BillingEvent {
  id          String   @id @default(cuid())
  workspaceId String?
  stripeEventId String @unique
  type        String
  payload     Json
  processedAt DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Plan {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}

enum ProfileTheme {
  MODERN_DARK
  NEON_CYAN
  AURORA_PURPLE
  MINIMAL_LIGHT
  SUNSET_ORANGE
  EMERALD_CLEAN
  MIDNIGHT_VELVET
  OCEAN_GRADIENT
  CUSTOM
}

enum ProfileBlockType {
  LINK
  TEXT_DIVIDER
  SOCIAL_LINKS
}

model Profile {
  id              String       @id @default(cuid())
  workspaceId     String
  handle          String       @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  theme           ProfileTheme @default(MODERN_DARK)
  themeSettings   Json?
  isPublished     Boolean      @default(true)
  customDomain    String?      @unique
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocks          ProfileBlock[]
  visits          ProfileVisit[]
  clicks          ProfileBlockClick[]

  @@index([workspaceId])
  @@index([handle])
}

model ProfileBlock {
  id             String           @id @default(cuid())
  profileId      String
  type           ProfileBlockType @default(LINK)
  title          String?
  url            String?
  description    String?
  imageUrl       String?
  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  config         Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  profile        Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clicks         ProfileBlockClick[]

  @@index([profileId])
  @@index([sortOrder])
}

model ProfileVisit {
  id          String   @id @default(cuid())
  profileId   String
  workspaceId String
  ipHash      String?
  userAgent   String?
  referrer    String?
  country     String?
  region      String?
  city        String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([profileId, createdAt])
}

model ProfileBlockClick {
  id             String   @id @default(cuid())
  profileId      String
  blockId        String
  workspaceId    String
  destinationUrl String
  ipHash         String?
  userAgent      String?
  referrer       String?
  country        String?
  region         String?
  city           String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime @default(now())

  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  block          ProfileBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([blockId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([profileId, createdAt])
}

// ─── Post Scheduler Models ──────────────────────────────────────────────────

enum PostPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  TWITTER
  LINKEDIN
}

enum PostMediaType {
  IMAGE
  VIDEO
  CAROUSEL
  REEL
  STORY
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model ScheduledPost {
  id                 String          @id @default(cuid())
  workspaceId        String
  instagramAccountId String?
  
  caption            String?
  mediaUrls          String[]        @default([])
  mediaType          PostMediaType   @default(IMAGE)
  platform           PostPlatform    @default(INSTAGRAM)
  
  scheduledFor       DateTime?
  publishedAt        DateTime?
  status             PostStatus      @default(DRAFT)
  
  queueVersion       Int             @default(0)
  publishAttemptedAt DateTime?
  quotaCountedAt     DateTime?

  // Meta container tracking
  metaContainerId    String?
  publishedPostId    String?
  publishedPostUrl   String?
  errorMessage       String?
  
  // Integrated auto-campaign
  autoCampaignEnabled   Boolean      @default(false)
  autoCampaignKeywords  String[]     @default([])
  autoCampaignDmMessage String?
  createdAutomationId   String?
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  workspace          Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([scheduledFor])
  @@index([workspaceId, status])
}


model BetaWaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  company   String?
  goal      String?
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadSource {
  BIO_LINK
  INSTAGRAM_DM
  CAMPAIGN
  MANUAL
  IMPORT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Contact {
  id                String     @id @default(cuid())
  workspaceId       String
  identityKey       String
  name              String?
  email             String?
  phone             String?
  instagramUsername String?
  instagramId       String?
  source            LeadSource
  sourceId          String?
  status            LeadStatus @default(NEW)
  tags              String[]   @default([])
  customFields      Json?
  lastInteractionAt DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  interactions      LeadInteraction[]

  @@unique([workspaceId, identityKey])
  @@index([workspaceId, status])
  @@index([workspaceId, lastInteractionAt])
}

model LeadInteraction {
  id           String     @id @default(cuid())
  workspaceId  String
  contactId    String
  automationId String?
  eventKey     String     @unique
  source       LeadSource
  sourceId     String?
  createdAt    DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, automationId])
  @@index([contactId, createdAt])
}
