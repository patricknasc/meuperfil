# MeuPerfil environment variables
#
# DS (local):  cp .env.example .env  — the defaults below work with `npm run services:up`.
# HM / PD:     set these in Vercel (Preview scoped to `develop` / Production) and in the
#              worker host. See docs/environments.md.
#
# Generate secrets with: openssl rand -hex 32

# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
CRON_SECRET=replace-with-openssl-rand-hex-32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Database
# DS: Docker Postgres from docker-compose.yml (host port 5433).
# HM/PD (Supabase): DATABASE_URL = Transaction pooler (port 6543) with
#   ?pgbouncer=true&connection_limit=1, DIRECT_URL = Session pooler (port 5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/meuperfil
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/meuperfil

# Queue (BullMQ). DS: Docker Redis. HM/PD: Upstash (rediss://...).
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
# DS: leave RESEND_API_KEY empty and the login link is printed in the `npm run dev` terminal.
RESEND_API_KEY=
EMAIL_FROM=MeuPerfil <login@meuperfil.me>

# Stripe (test mode in DS/HM, live mode only in PD)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-openssl-rand-hex-16
